{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zero-deck:product-requirements:declared-contract:1.0.0-draft",
  "title": "ZeroDeck PM-authored Software Rules declared contract",
  "description": "Applies the ZeroDeck PM profile to the upstream Software Rules declaredContract record. Register the pinned Software Rules records schema and the ZeroDeck PM extension schema when validating.",
  "allOf": [
    {
      "$ref": "urn:software-rules:schema:v1:records#/$defs/declaredContract"
    },
    {
      "type": "object",
      "properties": {
        "contractId": {
          "type": "string",
          "pattern": "^ZD-CONTRACT-[A-Z0-9-]+$"
        },
        "contractType": {
          "const": "product-requirements-contract"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "const": "ZeroDeck Product Management Agent"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "uri": { "type": "string", "format": "uri", "minLength": 1 },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-draft(\\.[0-9]+)?)?$" },
            "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "mediaType": { "const": "text/markdown" }
          },
          "required": ["uri", "version", "revision", "digest", "mediaType"],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "statementId": { "type": "string", "pattern": "^ZD-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$" },
              "text": { "type": "string", "minLength": 1 },
              "location": { "type": "string", "minLength": 1 }
            },
            "required": ["statementId", "text", "location"],
            "additionalProperties": false
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "uniqueItems": true
        },
        "extensions": {
          "type": "object",
          "properties": {
            "zeroDeckProductRequirements": {
              "$ref": "urn:zero-deck:product-requirements:extension:1.0.0-draft"
            }
          },
          "required": ["zeroDeckProductRequirements"],
          "additionalProperties": true
        }
      },
      "required": ["contractId", "contractType", "title", "issuer", "artifact", "scope", "statements", "evidenceRefs", "extensions"]
    }
  ]
}