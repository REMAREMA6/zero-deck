{
  "name": "zerodeck",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @zerodeck/api dev",
    "dev:web": "pnpm --filter @zerodeck/web dev",
    "dev:android": "pnpm --filter @zerodeck/android start",
    "lint": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,yml,yaml}\" \"packages/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
