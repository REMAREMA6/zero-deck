{
  "name": "@zerodeck/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/database.integration.test.ts",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@zerodeck/contracts": "workspace:*",
    "fastify": "^5.0.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
